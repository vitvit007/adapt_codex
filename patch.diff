+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>Adaptive Website Testing Tool</title>
+    <link rel="stylesheet" href="./styles.css" />
+  </head>
+  <body>
+    <div class="app">
+      <header class="control-panel">
+        <div class="row">
+          <label class="label" for="urlInput">URL</label>
+          <input id="urlInput" type="text" placeholder="https://example.com" />
+          <button id="loadBtn">Load</button>
+          <button id="reloadBtn" class="secondary">Reload</button>
+          <button id="openNewTabBtn" class="secondary">Open in new tab</button>
+        </div>
+
+        <div class="row wrap">
+          <label class="label" for="viewMode">View</label>
+          <select id="viewMode">
+            <option value="grid">Grid (2×2)</option>
+            <option value="single">Single</option>
+            <option value="split">Split</option>
+          </select>
+
+          <label class="label" for="singleDevice">Single device</label>
+          <select id="singleDevice"></select>
+
+          <label class="label" for="splitLeft">Split left</label>
+          <select id="splitLeft"></select>
+          <label class="label" for="splitRight">Split right</label>
+          <select id="splitRight"></select>
+
+          <label class="label" for="zoomRange">Zoom</label>
+          <input id="zoomRange" type="range" min="25" max="200" step="5" value="100" />
+          <span id="zoomLabel">100%</span>
+          <button id="fitBtn" class="secondary">Auto-fit</button>
+        </div>
+
+        <div class="row wrap">
+          <label class="toggle"><input id="framesToggle" type="checkbox" checked /> Device frames</label>
+          <label class="toggle"><input id="syncToggle" type="checkbox" /> Scroll sync</label>
+          <label class="toggle"><input id="widthOverlayToggle" type="checkbox" checked /> Width overlay</label>
+          <label class="toggle"><input id="breakpointToggle" type="checkbox" checked /> Breakpoint label</label>
+          <label class="toggle"><input id="gridOverlayToggle" type="checkbox" /> Grid overlay</label>
+        </div>
+
+        <div class="row wrap custom-row">
+          <strong>Custom resolution</strong>
+          <label class="label" for="customWidth">W</label>
+          <input id="customWidth" type="number" min="100" max="4000" value="1440" />
+          <label class="label" for="customHeight">H</label>
+          <input id="customHeight" type="number" min="100" max="4000" value="900" />
+          <button id="customApply" class="secondary">Apply custom</button>
+          <label class="toggle"><input id="customEnabled" type="checkbox" /> Enable custom device</label>
+        </div>
+
+        <p id="status" class="status">Enter a URL and click Load.</p>
+      </header>
+
+      <main id="viewportArea" class="viewport-area"></main>
+    </div>
+
+    <template id="viewportTemplate">
+      <section class="viewport-card">
+        <div class="viewport-header">
+          <div>
+            <strong class="device-name"></strong>
+            <span class="orientation"></span>
+          </div>
+          <div class="meta">
+            <span class="size-label"></span>
+            <button class="rotate-btn secondary" type="button">Rotate</button>
+          </div>
+        </div>
+
+        <div class="viewport-scroll-shell">
+          <div class="viewport-scale-wrap">
+            <div class="viewport-frame">
+              <iframe loading="lazy" referrerpolicy="no-referrer" sandbox="allow-forms allow-scripts allow-same-origin allow-popups"></iframe>
+              <div class="overlay width-overlay"></div>
+              <div class="overlay breakpoint-overlay"></div>
+              <div class="overlay grid-overlay"></div>
+            </div>
+          </div>
+        </div>
+      </section>
+    </template>
+
+    <script src="./app.js" type="module"></script>
+  </body>
+</html>
diff --git a/styles.css b/styles.css
