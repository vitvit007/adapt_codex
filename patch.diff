diff --git a/app.js b/app.js
new file mode 100644
index 0000000000000000000000000000000000000000..523dee61f04360a22304fe7f986bcdb1dd6261bc
--- /dev/null
+++ b/app.js
@@ -0,0 +1,399 @@
+const presetDevices = [
+  { id: 'desktop', name: 'Desktop', width: 1920, height: 1080, orientation: 'landscape', rotatable: false },
+  { id: 'laptop', name: 'Laptop', width: 1366, height: 768, orientation: 'landscape', rotatable: false },
+  { id: 'tablet', name: 'Tablet', width: 768, height: 1024, orientation: 'portrait', rotatable: true },
+  { id: 'mobile', name: 'Mobile', width: 375, height: 812, orientation: 'portrait', rotatable: true },
+];
+
+const state = {
+  url: '',
+  zoom: 100,
+  viewMode: 'grid',
+  singleDevice: 'desktop',
+  splitLeft: 'desktop',
+  splitRight: 'mobile',
+  showFrames: true,
+  scrollSync: false,
+  showWidthOverlay: true,
+  showBreakpointOverlay: true,
+  showGridOverlay: false,
+  customEnabled: false,
+  customDevice: {
+    id: 'custom',
+    name: 'Custom',
+    width: 1440,
+    height: 900,
+    orientation: 'landscape',
+    rotatable: true,
+  },
+  iframeReloadSeed: Date.now(),
+};
+
+const refs = {
+  urlInput: document.getElementById('urlInput'),
+  loadBtn: document.getElementById('loadBtn'),
+  reloadBtn: document.getElementById('reloadBtn'),
+  openNewTabBtn: document.getElementById('openNewTabBtn'),
+  viewMode: document.getElementById('viewMode'),
+  singleDevice: document.getElementById('singleDevice'),
+  splitLeft: document.getElementById('splitLeft'),
+  splitRight: document.getElementById('splitRight'),
+  zoomRange: document.getElementById('zoomRange'),
+  zoomLabel: document.getElementById('zoomLabel'),
+  fitBtn: document.getElementById('fitBtn'),
+  framesToggle: document.getElementById('framesToggle'),
+  syncToggle: document.getElementById('syncToggle'),
+  widthOverlayToggle: document.getElementById('widthOverlayToggle'),
+  breakpointToggle: document.getElementById('breakpointToggle'),
+  gridOverlayToggle: document.getElementById('gridOverlayToggle'),
+  customWidth: document.getElementById('customWidth'),
+  customHeight: document.getElementById('customHeight'),
+  customApply: document.getElementById('customApply'),
+  customEnabled: document.getElementById('customEnabled'),
+  status: document.getElementById('status'),
+  viewportArea: document.getElementById('viewportArea'),
+  viewportTemplate: document.getElementById('viewportTemplate'),
+};
+
+const openIds = new Set();
+let syncingScroll = false;
+
+function normalizeUrl(url) {
+  const trimmed = url.trim();
+  if (!trimmed) return { ok: false, reason: 'Please enter a URL.' };
+
+  const prefixed = /^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
+  try {
+    const parsed = new URL(prefixed);
+    if (!parsed.hostname) throw new Error('Invalid host');
+    return { ok: true, url: parsed.toString() };
+  } catch {
+    return { ok: false, reason: 'Invalid URL format.' };
+  }
+}
+
+function setStatus(message) {
+  refs.status.textContent = message;
+}
+
+function getAllDevices() {
+  const base = presetDevices.map((device) => ({ ...device }));
+  if (state.customEnabled) base.push({ ...state.customDevice });
+  return base;
+}
+
+function getVisibleDevices() {
+  const devices = getAllDevices();
+  if (state.viewMode === 'single') {
+    const single = devices.find((device) => device.id === state.singleDevice) ?? devices[0];
+    return single ? [single] : [];
+  }
+  if (state.viewMode === 'split') {
+    const left = devices.find((device) => device.id === state.splitLeft) ?? devices[0];
+    const right = devices.find((device) => device.id === state.splitRight) ?? devices[1] ?? devices[0];
+    return [left, right].filter(Boolean);
+  }
+  return devices.filter((device) => device.id !== 'custom').slice(0, 4);
+}
+
+function breakpointLabel(width) {
+  if (width < 768) return '<768 (mobile)';
+  if (width < 1024) return '768-1023 (tablet)';
+  if (width < 1280) return '1024-1279 (small laptop)';
+  return '>=1280 (desktop)';
+}
+
+function createIframeUrl(baseUrl) {
+  const url = new URL(baseUrl);
+  url.searchParams.set('_r', String(state.iframeReloadSeed));
+  return url.toString();
+}
+
+function applyAutoFit() {
+  const cards = [...document.querySelectorAll('.viewport-card')];
+  if (!cards.length) return;
+
+  let bestZoom = 200;
+  cards.forEach((card) => {
+    const frame = card.querySelector('.viewport-frame');
+    if (!frame) return;
+    const shell = card.querySelector('.viewport-scroll-shell');
+    const availableWidth = shell.clientWidth - 16;
+    const availableHeight = shell.clientHeight - 16;
+    const frameWidth = Number(frame.dataset.width);
+    const frameHeight = Number(frame.dataset.height);
+    const candidate = Math.min((availableWidth / frameWidth) * 100, (availableHeight / frameHeight) * 100);
+    if (Number.isFinite(candidate)) {
+      bestZoom = Math.min(bestZoom, candidate);
+    }
+  });
+
+  const zoom = Math.max(25, Math.min(200, Math.floor(bestZoom)));
+  state.zoom = zoom;
+  refs.zoomRange.value = String(zoom);
+  refs.zoomLabel.textContent = `${zoom}%`;
+  updateViewportScale();
+}
+
+function updateViewportScale() {
+  document.querySelectorAll('.viewport-scale-wrap').forEach((element) => {
+    element.style.transform = `scale(${state.zoom / 100})`;
+  });
+}
+
+function syncScrollFrom(sourceCard) {
+  if (!state.scrollSync || syncingScroll) return;
+  syncingScroll = true;
+
+  const shell = sourceCard.querySelector('.viewport-scroll-shell');
+  const ratioX = shell.scrollWidth > shell.clientWidth ? shell.scrollLeft / (shell.scrollWidth - shell.clientWidth) : 0;
+  const ratioY = shell.scrollHeight > shell.clientHeight ? shell.scrollTop / (shell.scrollHeight - shell.clientHeight) : 0;
+
+  document.querySelectorAll('.viewport-card').forEach((card) => {
+    if (card === sourceCard) return;
+    const targetShell = card.querySelector('.viewport-scroll-shell');
+    const maxX = targetShell.scrollWidth - targetShell.clientWidth;
+    const maxY = targetShell.scrollHeight - targetShell.clientHeight;
+    targetShell.scrollLeft = maxX > 0 ? ratioX * maxX : 0;
+    targetShell.scrollTop = maxY > 0 ? ratioY * maxY : 0;
+  });
+
+  setTimeout(() => {
+    syncingScroll = false;
+  }, 16);
+}
+
+function populateDeviceSelectors() {
+  const options = getAllDevices().map((device) => `<option value="${device.id}">${device.name}</option>`).join('');
+  refs.singleDevice.innerHTML = options;
+  refs.splitLeft.innerHTML = options;
+  refs.splitRight.innerHTML = options;
+  refs.singleDevice.value = state.singleDevice;
+  refs.splitLeft.value = state.splitLeft;
+  refs.splitRight.value = state.splitRight;
+}
+
+function renderViewports() {
+  refs.viewportArea.className = `viewport-area ${state.viewMode}`;
+  refs.viewportArea.innerHTML = '';
+  openIds.clear();
+
+  const visibleDevices = getVisibleDevices();
+  const currentUrl = state.url;
+
+  visibleDevices.forEach((device) => {
+    const fragment = refs.viewportTemplate.content.cloneNode(true);
+    const card = fragment.querySelector('.viewport-card');
+    const name = fragment.querySelector('.device-name');
+    const orientation = fragment.querySelector('.orientation');
+    const sizeLabel = fragment.querySelector('.size-label');
+    const frame = fragment.querySelector('.viewport-frame');
+    const iframe = fragment.querySelector('iframe');
+    const rotateBtn = fragment.querySelector('.rotate-btn');
+    const widthOverlay = fragment.querySelector('.width-overlay');
+    const breakpointOverlay = fragment.querySelector('.breakpoint-overlay');
+    const gridOverlay = fragment.querySelector('.grid-overlay');
+
+    const width = device.width;
+    const height = device.height;
+
+    name.textContent = device.name;
+    orientation.textContent = `(${device.orientation})`;
+    sizeLabel.textContent = `${width}×${height}`;
+
+    frame.style.width = `${width}px`;
+    frame.style.height = `${height}px`;
+    frame.dataset.width = String(width);
+    frame.dataset.height = String(height);
+    frame.classList.toggle('with-device-frame', state.showFrames);
+
+    widthOverlay.style.display = state.showWidthOverlay ? 'block' : 'none';
+    breakpointOverlay.style.display = state.showBreakpointOverlay ? 'block' : 'none';
+    gridOverlay.style.display = state.showGridOverlay ? 'block' : 'none';
+
+    widthOverlay.textContent = `Width: ${width}px`;
+    breakpointOverlay.textContent = breakpointLabel(width);
+
+    if (currentUrl) {
+      iframe.src = createIframeUrl(currentUrl);
+    } else {
+      iframe.srcdoc = '<p style="font-family: system-ui; padding: 16px;">Load a URL to preview.</p>';
+    }
+
+    rotateBtn.style.display = device.rotatable ? 'inline-flex' : 'none';
+    rotateBtn.addEventListener('click', () => {
+      rotateDevice(device.id);
+    });
+
+    card.addEventListener('scroll', () => syncScrollFrom(card), { passive: true, capture: true });
+
+    refs.viewportArea.appendChild(fragment);
+    openIds.add(device.id);
+  });
+
+  updateViewportScale();
+}
+
+function rotateDevice(deviceId) {
+  const rotateInList = (list) => {
+    const target = list.find((entry) => entry.id === deviceId);
+    if (!target || !target.rotatable) return false;
+    [target.width, target.height] = [target.height, target.width];
+    target.orientation = target.orientation === 'portrait' ? 'landscape' : 'portrait';
+    return true;
+  };
+
+  const rotatedPreset = rotateInList(presetDevices);
+  const rotatedCustom = state.customDevice.id === deviceId ? rotateInList([state.customDevice]) : false;
+
+  if (rotatedPreset || rotatedCustom) {
+    renderViewports();
+  }
+}
+
+function setModeVisibility() {
+  const isSingle = state.viewMode === 'single';
+  const isSplit = state.viewMode === 'split';
+  refs.singleDevice.disabled = !isSingle;
+  refs.splitLeft.disabled = !isSplit;
+  refs.splitRight.disabled = !isSplit;
+}
+
+function handleLoad() {
+  const result = normalizeUrl(refs.urlInput.value);
+  if (!result.ok) {
+    setStatus(result.reason);
+    return;
+  }
+
+  state.url = result.url;
+  refs.urlInput.value = result.url;
+  state.iframeReloadSeed = Date.now();
+  setStatus(`Loaded: ${result.url}`);
+  renderViewports();
+}
+
+function handleReload() {
+  if (!state.url) {
+    setStatus('Load a URL first.');
+    return;
+  }
+  state.iframeReloadSeed = Date.now();
+  renderViewports();
+  setStatus('Refreshed all active viewports.');
+}
+
+function initEvents() {
+  refs.loadBtn.addEventListener('click', handleLoad);
+  refs.urlInput.addEventListener('keydown', (event) => {
+    if (event.key === 'Enter') handleLoad();
+  });
+  refs.reloadBtn.addEventListener('click', handleReload);
+
+  refs.openNewTabBtn.addEventListener('click', () => {
+    if (!state.url) {
+      setStatus('Load a URL first to open it in a new tab.');
+      return;
+    }
+    window.open(state.url, '_blank', 'noopener,noreferrer');
+  });
+
+  refs.viewMode.addEventListener('change', (event) => {
+    state.viewMode = event.target.value;
+    setModeVisibility();
+    renderViewports();
+  });
+
+  refs.singleDevice.addEventListener('change', (event) => {
+    state.singleDevice = event.target.value;
+    renderViewports();
+  });
+
+  refs.splitLeft.addEventListener('change', (event) => {
+    state.splitLeft = event.target.value;
+    renderViewports();
+  });
+
+  refs.splitRight.addEventListener('change', (event) => {
+    state.splitRight = event.target.value;
+    renderViewports();
+  });
+
+  refs.zoomRange.addEventListener('input', (event) => {
+    state.zoom = Number(event.target.value);
+    refs.zoomLabel.textContent = `${state.zoom}%`;
+    updateViewportScale();
+  });
+
+  refs.fitBtn.addEventListener('click', applyAutoFit);
+
+  refs.framesToggle.addEventListener('change', (event) => {
+    state.showFrames = event.target.checked;
+    renderViewports();
+  });
+
+  refs.syncToggle.addEventListener('change', (event) => {
+    state.scrollSync = event.target.checked;
+    if (state.scrollSync) {
+      setStatus('Scroll sync enabled (best effort; cross-origin iframe syncing is browser-limited).');
+    }
+  });
+
+  refs.widthOverlayToggle.addEventListener('change', (event) => {
+    state.showWidthOverlay = event.target.checked;
+    renderViewports();
+  });
+
+  refs.breakpointToggle.addEventListener('change', (event) => {
+    state.showBreakpointOverlay = event.target.checked;
+    renderViewports();
+  });
+
+  refs.gridOverlayToggle.addEventListener('change', (event) => {
+    state.showGridOverlay = event.target.checked;
+    renderViewports();
+  });
+
+  refs.customEnabled.addEventListener('change', (event) => {
+    state.customEnabled = event.target.checked;
+    populateDeviceSelectors();
+    renderViewports();
+  });
+
+  refs.customApply.addEventListener('click', () => {
+    const width = Number(refs.customWidth.value);
+    const height = Number(refs.customHeight.value);
+    if (!Number.isFinite(width) || !Number.isFinite(height) || width < 100 || height < 100) {
+      setStatus('Custom size must be at least 100×100.');
+      return;
+    }
+    state.customDevice.width = width;
+    state.customDevice.height = height;
+    state.customDevice.orientation = width >= height ? 'landscape' : 'portrait';
+    populateDeviceSelectors();
+    renderViewports();
+    setStatus(`Custom device updated: ${width}×${height}`);
+  });
+
+  window.addEventListener('resize', debounce(() => {
+    if (state.zoom !== 100) return;
+    renderViewports();
+  }, 150));
+}
+
+function debounce(fn, delay) {
+  let timeout;
+  return (...args) => {
+    clearTimeout(timeout);
+    timeout = setTimeout(() => fn(...args), delay);
+  };
+}
+
+function init() {
+  populateDeviceSelectors();
+  setModeVisibility();
+  renderViewports();
+}
+
+initEvents();
+init();
