@@ -0,0 +1,219 @@
+:root {
+  color-scheme: light;
+  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
+  --panel-bg: #111827;
+  --panel-fg: #f9fafb;
+  --surface: #f3f4f6;
+  --card: #ffffff;
+  --border: #d1d5db;
+  --accent: #2563eb;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--surface);
+  color: #111827;
+}
+
+.app {
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+.control-panel {
+  position: sticky;
+  top: 0;
+  z-index: 5;
+  display: flex;
+  flex-direction: column;
+  gap: 0.7rem;
+  padding: 0.85rem;
+  background: var(--panel-bg);
+  color: var(--panel-fg);
+  border-bottom: 1px solid #374151;
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  gap: 0.55rem;
+}
+
+.wrap {
+  flex-wrap: wrap;
+}
+
+.label {
+  font-size: 0.875rem;
+  opacity: 0.9;
+}
+
+input[type="text"],
+input[type="number"],
+select {
+  min-height: 2rem;
+  border: 1px solid #4b5563;
+  background: #1f2937;
+  color: #f9fafb;
+  border-radius: 6px;
+  padding: 0 0.55rem;
+}
+
+input[type="text"] {
+  width: min(34rem, 65vw);
+}
+
+input[type="number"] {
+  width: 6rem;
+}
+
+button {
+  border: 1px solid var(--accent);
+  color: #fff;
+  background: var(--accent);
+  border-radius: 6px;
+  padding: 0.45rem 0.7rem;
+  font-weight: 600;
+  cursor: pointer;
+}
+
+button.secondary {
+  background: #374151;
+  border-color: #4b5563;
+}
+
+.toggle {
+  font-size: 0.875rem;
+  display: inline-flex;
+  gap: 0.35rem;
+  align-items: center;
+}
+
+.status {
+  margin: 0;
+  min-height: 1.2em;
+  font-size: 0.85rem;
+  opacity: 0.95;
+}
+
+.viewport-area {
+  flex: 1;
+  display: grid;
+  gap: 0.85rem;
+  padding: 0.85rem;
+  align-content: start;
+}
+
+.viewport-area.grid {
+  grid-template-columns: repeat(2, minmax(360px, 1fr));
+}
+
+.viewport-area.single {
+  grid-template-columns: minmax(360px, 1fr);
+}
+
+.viewport-area.split {
+  grid-template-columns: repeat(2, minmax(360px, 1fr));
+}
+
+.viewport-card {
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  min-height: 420px;
+}
+
+.viewport-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 0.6rem 0.75rem;
+  border-bottom: 1px solid var(--border);
+  background: #f8fafc;
+  font-size: 0.9rem;
+}
+
+.orientation,
+.size-label {
+  margin-left: 0.45rem;
+  opacity: 0.75;
+}
+
+.viewport-scroll-shell {
+  padding: 0.7rem;
+  overflow: auto;
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  justify-content: center;
+  align-items: flex-start;
+}
+
+.viewport-scale-wrap {
+  transform-origin: top center;
+}
+
+.viewport-frame {
+  position: relative;
+  border: 1px solid #cbd5e1;
+  background: #fff;
+}
+
+.viewport-frame.with-device-frame {
+  border: 10px solid #0f172a;
+  border-radius: 18px;
+  box-shadow: 0 12px 28px rgb(15 23 42 / 0.3);
+}
+
+iframe {
+  width: 100%;
+  height: 100%;
+  border: 0;
+  display: block;
+  background: #fff;
+}
+
+.overlay {
+  position: absolute;
+  left: 8px;
+  pointer-events: none;
+  font-size: 0.72rem;
+  font-weight: 600;
+  border-radius: 4px;
+  padding: 0.2rem 0.35rem;
+  color: #fff;
+  background: rgb(15 23 42 / 0.7);
+  display: none;
+}
+
+.width-overlay {
+  top: 8px;
+}
+
+.breakpoint-overlay {
+  top: 34px;
+}
+
+.grid-overlay {
+  inset: 0;
+  padding: 0;
+  background-image:
+    linear-gradient(to right, rgb(14 165 233 / 0.15) 1px, transparent 1px),
+    linear-gradient(to bottom, rgb(14 165 233 / 0.15) 1px, transparent 1px);
+  background-size: 24px 24px;
+}
+
+@media (max-width: 1024px) {
+  .viewport-area.grid,
+  .viewport-area.split {
+    grid-template-columns: minmax(320px, 1fr);
+  }
+}
